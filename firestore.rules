rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // ===== App collections =====

    // User profile
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Public user profile for leaderboard
    match /public_users/{uid} {
      allow read: if true;
      allow write: if signedIn() && request.auth.uid == uid;
    }

    // Gamified content: public read
    match /segments/{segmentId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /activities/{activityId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /daily_sprints/{dateKey} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Sprint completions are user-owned (id: {uid}_{yyyy-MM-dd})
    match /sprint_completions/{docId} {
      // NOTE: Transactions do `get()` on the document before it exists.
      // If we only allow reads based on `resource.data.userId`, the read of a
      // *missing* doc will be denied (because `resource` is null), and the whole
      // transaction fails with permission-denied.
      //
      // So we authorize reads/creates by docId prefix: {uid}_...
      allow read: if signedIn() && docId.matches('^' + request.auth.uid + '_.*$');
      allow create: if signedIn()
        && docId.matches('^' + request.auth.uid + '_.*$')
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // Sprint 2 daily completion marker (user-owned; id: {uid}_{yyyy-MM-dd})
    match /daily_completions/{docId} {
      allow read: if signedIn() && docId.matches('^' + request.auth.uid + '_.*$');
      allow create: if signedIn()
        && docId.matches('^' + request.auth.uid + '_.*$')
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // Learning content is public read (or change to `signedIn()` if you want auth required)
    match /learning_paths/{pathId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /modules/{moduleId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Analytics events (Sprint 1)
    // Each user can only write/read their own events.
    // (If you want admin dashboards later, read via server/admin SDK.)
    match /events/{eventId} {
      allow create: if isOwner(request.resource.data.userId);
      allow read: if isOwner(resource.data.userId);
      allow update, delete: if false;
    }

    // Enrollment: each user can only see/change their own enrollment docs
    match /user_enrollments/{docId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;

      // Create: userId must match auth.uid
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;

      // Update: keep ownership; allow status changes
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;

      allow delete: if false;
    }

    // Progress: each user can only see/change their own progress docs
    match /user_progress/{docId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;

      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;

      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;

      allow delete: if false;
    }

    // Optional: allow signed-in users to write debug pings
    match /debug_pings/{docId} {
      allow create: if signedIn();
      allow read, update, delete: if false;
    }
  }
}


